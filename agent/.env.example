# Copy this file to .env and fill in the values. Never commit .env.

# Free key from https://console.groq.com (starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Your Leash wallet contract and the agent account allowed to use it
LEASH_CONTRACT=meetaminx-leash.testnet
AGENT_ACCOUNT=meetaminx-agent.testnet

# Filled in automatically by `npm run setup-key`.
# This key can ONLY call request_payment on the Leash contract.
AGENT_PRIVATE_KEY=

# Injection filter (Llama Prompt Guard 2 on Groq): off, warn or block.
# Override for one run with --filter off|warn|block.
INJECTION_FILTER=warn
INJECTION_THRESHOLD=0.5
SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b
